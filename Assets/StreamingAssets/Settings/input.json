{
  "_source": "Managers/InputManager.cs SetupKeys, SetupButtons and its literal keys (RECONSTRUCTION 3.1, 3.2, 9.2, 10.2). Keys are XNA Keys names, buttons XNA Buttons names. How each action is read (on press or held, in which state, in which order) is the original's and lives in InputRouter: jump reads its keys on press and its buttons while held; moving, kneeling, the camera keys, Ctrl, Shift and the editor's screen cursor are held; everything else is on press.",
  "_consoleTyping": "CheckInput_Console's chain in its order: the first entry whose key is pressed (a shift entry also needs Shift) appends its text; Shift+' appends two apostrophes, as the original did. A key with no entry appends its own name in lower case, except the consoleIgnores.",
  "stickPressPoint": 0.5,
  "mapEditorMouse": "Middle",
  "bindings": {
    "mainMenu": { "keys": ["Escape"], "buttons": ["Start"] },
    "console": { "keys": ["OemTilde"], "buttons": ["Back"] },
    "moveLeft": { "keys": ["A"], "buttons": ["LeftThumbstickLeft"] },
    "moveRight": { "keys": ["D"], "buttons": ["LeftThumbstickRight"] },
    "kneel": { "keys": ["S"], "buttons": ["LeftThumbstickDown"] },
    "jump": { "keys": ["Space"], "buttons": ["A"] },
    "reset": { "keys": ["R"], "buttons": [] },
    "cycleLeft": { "keys": ["OemOpenBrackets"], "buttons": ["LeftShoulder"] },
    "cycleRight": { "keys": ["OemCloseBrackets"], "buttons": ["RightShoulder"] },
    "fullscreen": { "keys": ["F12"], "buttons": [] },
    "quickBar": { "keys": ["U"], "buttons": [] },
    "cameraMode": { "keys": ["C"], "buttons": [] },
    "mapEditor": { "keys": ["M"], "buttons": [] },
    "scrollLeft": { "keys": ["Delete"], "buttons": [] },
    "scrollRight": { "keys": ["PageDown"], "buttons": [] },
    "scrollUp": { "keys": ["Home"], "buttons": [] },
    "scrollDown": { "keys": ["End"], "buttons": [] },
    "zoomIn": { "keys": ["OemPlus"], "buttons": [] },
    "zoomOut": { "keys": ["OemMinus"], "buttons": [] },
    "rotateLeft": { "keys": ["Insert"], "buttons": [] },
    "rotateRight": { "keys": ["PageUp"], "buttons": [] },
    "editorScreenCursor": { "keys": ["Space"], "buttons": [] },
    "editorLeft": { "keys": ["A"], "buttons": ["DPadLeft"] },
    "editorRight": { "keys": ["D"], "buttons": ["DPadRight"] },
    "editorUp": { "keys": ["W"], "buttons": ["DPadUp"] },
    "editorDown": { "keys": ["S"], "buttons": ["DPadDown"] },
    "ctrl": { "keys": ["LeftControl", "RightControl"], "buttons": [] },
    "shift": { "keys": ["LeftShift", "RightShift"], "buttons": [] },
    "menuBack": { "keys": ["A", "Left"], "buttons": ["DPadLeft", "B", "LeftThumbstickLeft"] },
    "menuSelect": { "keys": ["Enter", "D", "Right"], "buttons": ["DPadRight", "LeftThumbstickRight", "A"] },
    "menuUp": { "keys": ["W", "Up"], "buttons": ["DPadUp", "LeftThumbstickUp"] },
    "menuDown": { "keys": ["S", "Down"], "buttons": ["DPadDown", "LeftThumbstickDown"] },
    "consoleSubmit": { "keys": ["Enter"], "buttons": [] },
    "consoleClear": { "keys": ["Delete"], "buttons": [] },
    "consoleBackspace": { "keys": ["Back"], "buttons": [] },
    "consoleRecall": { "keys": ["Up"], "buttons": [] },
    "consoleSpace": { "keys": ["Space"], "buttons": [] }
  },
  "consoleTyping": [
    { "key": "D0", "shift": true, "text": ")" },
    { "key": "D1", "shift": true, "text": "!" },
    { "key": "D2", "shift": true, "text": "@" },
    { "key": "D3", "shift": true, "text": "#" },
    { "key": "D4", "shift": true, "text": "$" },
    { "key": "D5", "shift": true, "text": "%" },
    { "key": "D6", "shift": true, "text": "^" },
    { "key": "D7", "shift": true, "text": "&" },
    { "key": "D8", "shift": true, "text": "*" },
    { "key": "D9", "shift": true, "text": "(" },
    { "key": "OemMinus", "shift": true, "text": "_" },
    { "key": "OemPlus", "shift": true, "text": "+" },
    { "key": "D0", "shift": false, "text": "0" },
    { "key": "D1", "shift": false, "text": "1" },
    { "key": "D2", "shift": false, "text": "2" },
    { "key": "D3", "shift": false, "text": "3" },
    { "key": "D4", "shift": false, "text": "4" },
    { "key": "D5", "shift": false, "text": "5" },
    { "key": "D6", "shift": false, "text": "6" },
    { "key": "D7", "shift": false, "text": "7" },
    { "key": "D8", "shift": false, "text": "8" },
    { "key": "D9", "shift": false, "text": "9" },
    { "key": "OemMinus", "shift": false, "text": "-" },
    { "key": "OemPlus", "shift": false, "text": "=" },
    { "key": "OemOpenBrackets", "shift": true, "text": "{" },
    { "key": "OemCloseBrackets", "shift": true, "text": "}" },
    { "key": "OemPipe", "shift": true, "text": "|" },
    { "key": "OemSemicolon", "shift": true, "text": ":" },
    { "key": "OemQuotes", "shift": true, "text": "''" },
    { "key": "OemComma", "shift": true, "text": "<" },
    { "key": "OemPeriod", "shift": true, "text": ">" },
    { "key": "OemQuestion", "shift": true, "text": "?" },
    { "key": "OemOpenBrackets", "shift": false, "text": "[" },
    { "key": "OemCloseBrackets", "shift": false, "text": "]" },
    { "key": "OemPipe", "shift": false, "text": "\\" },
    { "key": "OemSemicolon", "shift": false, "text": ";" },
    { "key": "OemQuotes", "shift": false, "text": "'" },
    { "key": "OemComma", "shift": false, "text": "," },
    { "key": "OemPeriod", "shift": false, "text": "." },
    { "key": "OemQuestion", "shift": false, "text": "/" }
  ],
  "consoleIgnores": ["LeftShift"]
}
