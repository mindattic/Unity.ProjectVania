<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free Unity source (Assets/Unity.ProjectVania/Core) as a plain .NET Standard 2.1
       library, matching Unity 6 (C# 9), so the rules are testable in seconds without the editor. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Unity.ProjectVania.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Unity.ProjectVania/Core/**/*.cs" />
  </ItemGroup>
</Project>
